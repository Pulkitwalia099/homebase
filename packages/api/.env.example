# Copy this to .env and fill in real values
# NEVER commit .env to git

# Database — must be postgresql+asyncpg:// with ?sslmode=require for Supabase
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# Stripe (use sk_test_ for dev, sk_live_ for prod)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BOOKING_FEE_CENTS=3500

# App
SECRET_KEY=generate-with-python-secrets-token-hex-32
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
INTERNAL_API_KEY=generate-with-python-secrets-token-hex-16

# Supabase Storage
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=job-photos
